      "records": [
        {
          "key": "overview",
          "sourceKey": "act1",
          "topic": "典仪惊变与寻仙",
          "task": "浮世浮生千岩间",
          "keywords": [
            "全幕",
            "请仙典仪",
            "寻仙"
          ],
          "text": "旅行者抵达璃月参加请仙典仪，却因突发变故卷入追捕。在公子指引下，旅行者去绝云间求助，并向多位仙人传信；完成寻访后返回璃月港，获悉仙祖法蜕已被限制接触。神明为何遇害仍是本幕悬念。",
          "overview": true,
          "sourceTitles": [
            "请仙",
            "惊变",
            "返尘"
          ],
          "sourceTitle": "请仙",
          "sourceRevision": "665440",
          "sourceVerificationLevel": "dialogue",
          "section": "相关具体子任务的描述、流程与对白"
        },
        {
          "key": "rite",
          "sourceKey": "rite",
          "topic": "为什么参加请仙典仪",
          "task": "请仙",
          "keywords": [
            "请仙典仪",
            "岩王帝君",
            "神谕",
            "一年一度"
          ],
          "text": "旅行者想见岩神，抵达时正赶上一年一度的请仙典仪。按璃月惯例，岩王帝君会在仪式中降下神谕，为这一年的经营指引方向。",
          "sourceTitles": [
            "请仙"
          ]
        },
        {
          "key": "escape",
          "sourceKey": "rite",
          "topic": "为什么逃离现场",
          "task": "请仙",
          "keywords": [
            "旅行者",
            "逃离",
            "追捕",
            "嫌疑",
            "典仪"
          ],
          "text": "神躯坠落后，凝光宣布封锁现场。旅行者担心所寻的神可能与当年的敌人有关，不愿落入其信徒手中，于是离开并遭到追捕；逃跑不能被当成行刺证据。",
          "sourceTitles": [
            "请仙"
          ]
        },
        {
          "key": "help",
          "sourceKey": "rite",
          "topic": "公子的援手",
          "task": "请仙",
          "keywords": [
            "公子",
            "帮助",
            "愚人众",
            "北国银行"
          ],
          "text": "公子帮助旅行者脱离千岩军追捕，并表明自己属于愚人众执行官。接受这次援助并不意味着双方已经消除戒心，更不能据此确认他的全部目的。",
          "sourceTitles": [
            "请仙"
          ]
        },
        {
          "key": "talisman",
          "sourceKey": "shock",
          "topic": "百无禁忌箓的作用",
          "task": "惊变",
          "keywords": [
            "百无禁忌箓",
            "百无禁忌篆",
            "信物",
            "削月筑阳真君"
          ],
          "text": "削月筑阳真君认出旅行者携带的百无禁忌箓，愿意听取来意。千岩军追至后，他要求驱离追兵而不杀生，随后让旅行者携信物向其他仙人传话。",
          "sourceTitles": [
            "惊变"
          ]
        },
        {
          "key": "suspicion",
          "sourceKey": "inn",
          "topic": "怀疑七星的叙述边界",
          "task": "望舒",
          "keywords": [
            "七星",
            "怀疑",
            "幕后黑手",
            "事实",
            "推断"
          ],
          "text": "任务说明将七星可能涉案写作削月筑阳真君的推断。这反映仙人当时对七星处置的质疑，不能据此断定七星谋害了帝君；当前阶段仍缺少证明真凶的证据。",
          "sourceTitles": [
            "望舒"
          ]
        },
        {
          "key": "xiao",
          "sourceKey": "inn",
          "topic": "魈为何不愿接近凡人",
          "task": "望舒",
          "keywords": [
            "魈",
            "冷淡",
            "伤害",
            "杏仁豆腐",
            "菲尔戈黛特"
          ],
          "text": "魈警告凡人接近仙魔会承受危险，信物也不能消除这种风险。菲尔戈黛特建议准备杏仁豆腐和拿手菜，帮助旅行者再次与他交流。",
          "sourceTitles": [
            "望舒"
          ]
        },
        {
          "key": "ghost",
          "sourceKey": "inn",
          "topic": "小冥与客栈闹鬼",
          "task": "望舒",
          "keywords": [
            "小冥",
            "言笑",
            "鬼魂",
            "降魔印",
            "望舒客栈"
          ],
          "text": "在老板指点下，旅行者借降魔印寻找小冥，经历追逐与战斗后与她交流。小冥答应不再捉弄客人，但希望旅行者继续陪自己玩。",
          "sourceTitles": [
            "望舒"
          ]
        },
        {
          "key": "brothers",
          "sourceKey": "mountain",
          "topic": "李丁李当与琥珀",
          "task": "叠山",
          "keywords": [
            "李丁",
            "李当",
            "琥珀",
            "理水叠山真君"
          ],
          "text": "旅行者敲碎琥珀救出李当，两兄弟将救助者误认成仙使。理水叠山真君原本责问放走受罚者的行为；见到信物、听到口信后，转而听取璃月港变故并准备查证。",
          "sourceTitles": [
            "叠山"
          ]
        },
        {
          "key": "cloud",
          "sourceKey": "cloud",
          "topic": "留云借风真君的洞府",
          "task": "留云",
          "keywords": [
            "留云借风真君",
            "供奉",
            "机关",
            "洞府"
          ],
          "text": "旅行者根据食物痕迹备好供奉，并闯过留云借风真君布置的机关洞府。她听闻帝君遇刺后震怒，提出强硬处置；这是当时的反应，并非已经完成的行动。",
          "sourceTitles": [
            "留云"
          ]
        },
        {
          "key": "parallel",
          "sourceKey": "mountain",
          "topic": "多路寻仙的顺序",
          "task": "叠山",
          "keywords": [
            "并行",
            "顺序",
            "望舒",
            "留云",
            "叠山"
          ],
          "text": "任务页面把望舒、叠山、留云列为并行寻仙线索，最终汇入返尘。页面部分任务条件与并行栏存在顺序差异，这里按分线整理，不把索引排列当成唯一游玩顺序。",
          "sourceTitles": [
            "望舒",
            "叠山",
            "留云",
            "返尘"
          ]
        },
        {
          "key": "return",
          "sourceKey": "return",
          "topic": "返尘时公子的消息",
          "task": "返尘",
          "keywords": [
            "公子",
            "仙祖法蜕",
            "藏匿",
            "封锁",
            "七星"
          ],
          "text": "公子称七星以真凶未明为由限制瞻仰仙祖法蜕，并对这一做法表示怀疑。讲解需保留消息的讲述者和立场，不把他的质疑直接转成客观定论。",
          "sourceTitles": [
            "返尘"
          ]
        }
      ]
    },
