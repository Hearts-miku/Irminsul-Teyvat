          ],
          "sourceVerificationLevel": "dialogue"
        },
        {
          "key": "forest",
          "sourceKey": "forest",
          "task": "林间相会",
          "topic": "林中相会与赤色结晶",
          "keywords": [
            "林间相会",
            "巨龙",
            "神秘人",
            "结晶",
            "赤色",
            "打扰"
          ],
          "text": "旅行者在树林里撞见神秘人与巨龙交谈。相会受到打扰后，他们离开，旅行者随后调查并取得赤色结晶；本场景尚未揭示全部身份和结晶成因。"
        },
        {
          "key": "escort",
          "sourceKey": "amber",
          "task": "随风而来的骑士",
          "topic": "安柏的警惕和护送",
          "keywords": [
            "安柏",
            "护送",
            "信任",
            "盘问",
            "为什么"
          ],
          "text": "安柏以侦察骑士身份盘问陌生旅人，随后提出护送。她既担心城外巨龙，也继续留意来历不明者，所以保护和警惕同时存在，不能说初见时已经完全信任。"
        },
        {
          "key": "paimon",
          "sourceKey": "amber",
          "task": "随风而来的骑士",
          "topic": "派蒙介绍是互斥选择",
          "keywords": [
